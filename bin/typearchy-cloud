#!/usr/bin/env bash
set -euo pipefail

api_url="${TYPEARCHY_API_URL:-https://typearchy.com}"
state_dir="${TYPEARCHY_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/typearchy}"
credentials_path="$state_dir/profile.json"
pending_path="$state_dir/profile-pending.json"

mkdir -p "$state_dir"
chmod 700 "$state_dir"
umask 077

json_error() {
  jq -cn --arg error "$1" '{error:$error}'
  exit 1
}

temp_files=()
cleanup_temps() {
  local file
  for file in "${temp_files[@]}"; do rm -f "$file" 2>/dev/null || true; done
}
trap cleanup_temps EXIT

token_from_file() {
  jq -er '.token' "$1" 2>/dev/null || json_error "Profile connection is missing or damaged"
}

last_http_code_path="$state_dir/last-http-code"

request() {
  local method="$1" path="$2" token="${3:-}" body="${4:-}" attempt_token="${5:-}"
  local config_path body_path="" output status
  config_path="$(mktemp "$state_dir/request.XXXXXX")"
  temp_files=("$config_path")
  if [[ -n "$body" ]]; then
    body_path="$(mktemp "$state_dir/body.XXXXXX")"
    temp_files=("$config_path" "$body_path")
    printf '%s' "$body" > "$body_path"
  fi
  {
    printf 'silent\nshow-error\nfail-with-body\n'
    printf 'connect-timeout = 10\nmax-time = 30\n'
    printf 'url = "%s%s"\n' "$api_url" "$path"
    printf 'request = "%s"\n' "$method"
    printf 'header = "Accept: application/json"\n'
    if [[ -n "$token" ]]; then printf 'header = "Authorization: Bearer %s"\n' "$token"; fi
    if [[ -n "$attempt_token" ]]; then printf 'header = "X-Attempt-Token: %s"\n' "$attempt_token"; fi
    if [[ -n "$body" ]]; then printf 'header = "Content-Type: application/json"\ndata-binary = "@%s"\n' "$body_path"; fi
    printf 'write-out = "%%{http_code}"\n'
  } > "$config_path"
  set +e
  output="$(curl --config "$config_path")"
  status=$?
  set -e
  rm -f "$config_path"
  if [[ -n "$body_path" ]]; then rm -f "$body_path"; fi
  rm -f "$last_http_code_path"
  local code=""
  if [[ "$status" -eq 0 || "$status" -eq 22 ]]; then
    code="${output: -3}"
    output="${output:0:${#output}-3}"
  fi
  if [[ -n "$code" ]]; then printf '%s' "$code" > "$last_http_code_path"; fi
  printf '%s' "$output"
  return "$status"
}

credentials_rejected() {
  [[ -f "$last_http_code_path" ]] || return 1
  local code
  code="$(cat "$last_http_code_path")"
  [[ "$code" == "401" || "$code" == "403" ]]
}

new_token() {
  printf 'tpy_%s' "$(openssl rand -hex 32)"
}

save_connected() {
  local token="$1" response="$2"
  jq -cn --arg token "$token" --arg handle "$(jq -r '.handle' <<<"$response")" \
    --arg profileUrl "$(jq -r '.profileUrl' <<<"$response")" \
    '{version:1,token:$token,handle:$handle,profileUrl:$profileUrl}' > "$credentials_path"
  chmod 600 "$credentials_path"
  rm -f "$pending_path"
}

status() {
  if [[ -f "$credentials_path" ]]; then
    local token response
    token="$(token_from_file "$credentials_path")"
    if response="$(request GET /api/device "$token" 2>/dev/null)"; then
      save_connected "$token" "$response"
      printf '%s\n' "$response"
    elif credentials_rejected; then
      rm -f "$credentials_path"
      jq -cn '{status:"disconnected"}'
    else
      jq -cn '{status:"unreachable"}'
    fi
    return
  fi
  if [[ -f "$pending_path" ]]; then
    local token kind response
    token="$(token_from_file "$pending_path")"
    kind="$(jq -r '.kind // "connect"' "$pending_path")"
    if response="$(request GET /api/connect/status "$token" 2>/dev/null)"; then
      if [[ "$(jq -r '.status' <<<"$response")" == "connected" ]]; then save_connected "$token" "$response"; fi
      printf '%s\n' "$response"
    elif credentials_rejected; then
      rm -f "$pending_path"
      jq -cn '{status:"disconnected"}'
    else
      jq -cn --arg kind "$kind" '{status:"pending",kind:$kind}'
    fi
    return
  fi
  jq -cn '{status:"disconnected"}'
}

connect_profile() {
  if [[ -f "$credentials_path" ]]; then status; return; fi
  local token label payload response
  token="$(new_token)"
  label="Typearchy on $(hostnamectl hostname 2>/dev/null || hostname)"
  payload="$(jq -cn --arg token "$token" --arg label "$label" '{token:$token,label:$label}')"
  response="$(request POST /api/connect/start '' "$payload")"
  jq -cn --arg token "$token" --arg code "$(jq -r '.code' <<<"$response")" \
    --arg url "$(jq -r '.verificationUrl' <<<"$response")" \
    '{version:1,kind:"connect",token:$token,code:$code,url:$url}' > "$pending_path"
  chmod 600 "$pending_path"
  if [[ "${TYPEARCHY_NO_BROWSER:-0}" != "1" ]]; then xdg-open "$(jq -r '.verificationUrl' <<<"$response")" >/dev/null 2>&1 & fi
  printf '%s\n' "$response"
}

recover_profile() {
  local token payload response
  token="$(new_token)"
  payload="$(jq -cn --arg token "$token" \
    --arg label "Typearchy on $(hostnamectl hostname 2>/dev/null || hostname)" \
    '{token:$token,label:$label,kind:"recover"}')"
  response="$(request POST /api/connect/start '' "$payload")"
  jq -cn --arg token "$token" --arg code "$(jq -r '.code' <<<"$response")" \
    --arg url "$(jq -r '.verificationUrl' <<<"$response")" \
    '{version:1,kind:"recover",token:$token,code:$code,url:$url}' > "$pending_path"
  chmod 600 "$pending_path"
  if [[ "${TYPEARCHY_NO_BROWSER:-0}" != "1" ]]; then xdg-open "$(jq -r '.verificationUrl' <<<"$response")" >/dev/null 2>&1 & fi
  printf '%s\n' "$response"
}

disconnect_profile() {
  if [[ -f "$credentials_path" ]]; then
    local token
    token="$(token_from_file "$credentials_path")"
    request DELETE /api/device "$token" >/dev/null 2>&1 || true
  fi
  rm -f "$credentials_path" "$pending_path"
  jq -cn '{status:"disconnected"}'
}

delete_profile() {
  [[ -f "$credentials_path" ]] || json_error "Connect a public profile first"
  local token response
  token="$(token_from_file "$credentials_path")"
  response="$(request DELETE /api/profile "$token")"
  rm -f "$credentials_path" "$pending_path"
  printf '%s\n' "$response"
}

visibility_profile() {
  [[ -f "$credentials_path" ]] || json_error "Connect a public profile first"
  local visibility="${1:-}" token body
  [[ "$visibility" == "public" || "$visibility" == "private" ]] || json_error "Visibility must be public or private"
  token="$(token_from_file "$credentials_path")"
  body="$(jq -cn --arg visibility "$visibility" '{visibility:$visibility}')"
  request PATCH /api/profile "$token" "$body"
}

publish_run() {
  [[ -f "$credentials_path" ]] || json_error "Connect a public profile first"
  local input_path="${1:-}" token body
  token="$(token_from_file "$credentials_path")"
  if [[ -n "$input_path" ]]; then
    [[ "$input_path" == "$state_dir/"* && -f "$input_path" ]] || json_error "Run data is unavailable"
    body="$(jq -c '.' "$input_path" 2>/dev/null)" || json_error "Run data is invalid"
    rm -f "$input_path"
  else
    body="$(jq -c '.' 2>/dev/null)" || json_error "Run data is invalid"
  fi
  request POST /api/runs "$token" "$body"
}

pin_run() {
  [[ -f "$credentials_path" ]] || json_error "Connect a public profile first"
  local slug="${1:-}" pinned="${2:-true}" token body
  [[ "$slug" =~ ^[A-HJ-NP-Z2-9]{8}$ ]] || json_error "Run URL is invalid"
  [[ "$pinned" == "true" || "$pinned" == "false" ]] || json_error "Pin state is invalid"
  token="$(token_from_file "$credentials_path")"
  body="$(jq -cn --argjson pinned "$pinned" '{pinned:$pinned}')"
  request PATCH "/api/runs/$slug" "$token" "$body"
}

delete_run() {
  [[ -f "$credentials_path" ]] || json_error "Connect a public profile first"
  local slug="${1:-}" token
  [[ "$slug" =~ ^[A-HJ-NP-Z2-9]{8}$ ]] || json_error "Run URL is invalid"
  token="$(token_from_file "$credentials_path")"
  request DELETE "/api/runs/$slug" "$token"
}

load_challenge() {
  local slug="${1:-}" ghost="${2:-}" path token=""
  [[ "$slug" =~ ^[a-z0-9]{12}$ ]] || json_error "Challenge link is invalid"
  [[ -z "$ghost" || "$ghost" =~ ^[a-z0-9]{12}$ ]] || json_error "Opponent link is invalid"
  path="/api/challenges/$slug"
  if [[ -n "$ghost" ]]; then path="$path?race=$ghost"; fi
  if [[ -f "$credentials_path" ]]; then token="$(token_from_file "$credentials_path")"; fi
  request GET "$path" "$token"
}

start_attempt() {
  local slug="${1:-}" token="" response id
  [[ "$slug" =~ ^[a-z0-9]{12}$ ]] || json_error "Challenge link is invalid"
  if [[ -f "$credentials_path" ]]; then token="$(token_from_file "$credentials_path")"; fi
  response="$(request POST "/api/challenges/$slug/attempts" "$token")"
  id="$(jq -er '.id' <<<"$response")"
  [[ "$id" =~ ^[a-f0-9-]{36}$ ]] || json_error "Invalid attempt session"
  jq -c '.' <<<"$response" > "$state_dir/attempt-$id.json"
  jq -c 'del(.token)' <<<"$response"
}

submit_attempt() {
  local id="${1:-}" input_path="${2:-}" token body
  [[ "$id" =~ ^[a-f0-9-]{36}$ ]] || json_error "Invalid attempt session"
  [[ "$input_path" == "$state_dir/attempt-recording.json" && -f "$input_path" ]] || json_error "Recording is unavailable"
  token="$(token_from_file "$state_dir/attempt-$id.json")"
  [[ "$token" =~ ^[a-f0-9]{64}$ ]] || json_error "Invalid attempt token"
  body="$(jq -c '{events: .events, theme: .theme}' "$input_path")"
  request POST "/api/attempts/$id" '' "$body" "$token"
}

publish_attempt() {
  local id="${1:-}" token attempt_token
  [[ "$id" =~ ^[a-f0-9-]{36}$ ]] || json_error "Invalid attempt session"
  [[ -f "$credentials_path" ]] || json_error "Connect your profile in History, then publish this result"
  token="$(token_from_file "$credentials_path")"
  attempt_token="$(token_from_file "$state_dir/attempt-$id.json")"
  [[ "$attempt_token" =~ ^[a-f0-9]{64}$ ]] || json_error "Invalid attempt token"
  request POST "/api/attempts/$id/publish" "$token" '' "$attempt_token"
}

case "${1:-status}" in
  status) status ;;
  connect) connect_profile ;;
  recover) recover_profile ;;
  disconnect) disconnect_profile ;;
  delete-profile) delete_profile ;;
  visibility) visibility_profile "${2:-}" ;;
  publish) publish_run "${2:-}" ;;
  pin) pin_run "${2:-}" "${3:-true}" ;;
  delete) delete_run "${2:-}" ;;
  challenge) load_challenge "${2:-}" "${3:-}" ;;
  attempt-start) start_attempt "${2:-}" ;;
  attempt-submit) submit_attempt "${2:-}" "${3:-}" ;;
  attempt-publish) publish_attempt "${2:-}" ;;
  *) json_error "Unknown profile action" ;;
esac
