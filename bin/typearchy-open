#!/usr/bin/env bash
set -euo pipefail
value="${1:-}"
slug=""; ghost=""
if [[ "$value" =~ ^typearchy://challenge/([a-z0-9]{12})(\?race=([a-z0-9]{12}))?/?$ ]]; then
  slug="${BASH_REMATCH[1]}"; ghost="${BASH_REMATCH[3]:-}"
elif [[ "$value" =~ ^https://typearchy\.com/c/([a-z0-9]{12})(\?race=([a-z0-9]{12}))?/?$ ]]; then
  slug="${BASH_REMATCH[1]}"; ghost="${BASH_REMATCH[3]:-}"
else
  printf 'Not a Typearchy challenge link.\n' >&2
  exit 1
fi
payload="$(jq -cn --arg challenge "$slug" --arg ghost "$ghost" '{challenge:$challenge,ghost:$ghost}')"
exec omarchy-shell shell summon dev.typearchy.game "$payload"
